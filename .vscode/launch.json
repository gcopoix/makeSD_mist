{
	// See https://code.visualstudio.com/docs/debugtest/debugging-configuration
	// for the documentation about the launch.json format
	// https://code.visualstudio.com/docs/editor/variables-reference

	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Bash genSD.sh",
			"type": "bashdb",
			"request": "launch",
			"program": "${workspaceFolder}/Linux/genSD.sh",
			"cwd": "${workspaceFolder}",
			"args": [
				"-s", "${input:fpga}",
				"-d", "./Linux/SD/${input:fpga}"
			],
			"terminalKind": "integrated",
		},
		{
			"name": "Launch PowerShell genSD.ps1",
			"type": "PowerShell",
			"request": "launch",
			"script": "${workspaceFolder}/Windows/genSD.ps1",
			"cwd": "${cwd}",
			"args": [
				"-s", "${input:fpga}",
				"-d", "./Windows/SD/${input:fpga}"
			],
		},
	],
	"inputs": [
		{
			"id": "fpga",
			"type": "pickString",
			"description": "What target FPGA system distribution do you want to create?",
			"options": [
				"MiST",
				"SiDi",
				"SiDi128"
			],
		}
	]
}
